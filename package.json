{
  "name": "dsh-projectops",
  "version": "0.8.0",
  "description": "DSH ProjectOps — 项目工程管家插件：结构扫描、Python 与 TypeScript/JavaScript 依赖分析、循环依赖与 Mermaid 架构图、SQLite 任务管理、架构文档生成",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./client": "./lib/client/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "locale"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "project-scanner",
    "dependency-analysis",
    "mermaid",
    "architecture",
    "sqlite",
    "project-management",
    "javascript",
    "typescript",
    "static-analysis"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "test": "node --test --import ./tests/support/runtime-hooks.mjs \"tests/**/*.test.ts\"",
    "test:ci": "node --test --import ./tests/support/runtime-hooks.mjs \"tests/services.*.test.ts\" \"tests/security.*.test.ts\" \"tests/util.*.test.ts\" \"tests/storage.*.test.ts\" \"tests/adapters.*.test.ts\" \"tests/tools.*.test.ts\"",
    "demo": "node scripts/demo-scan.mjs",
    "demo:analyze": "node scripts/demo-analyze.mjs",
    "demo:report": "node scripts/demo-report.mjs",
    "install:profile": "node scripts/install-into-profile.mjs",
    "rollback:profile": "node scripts/install-into-profile.mjs --rollback",
    "verify": "node scripts/verify.mjs",
    "test:coverage": "node --test --experimental-test-coverage --import ./tests/support/runtime-hooks.mjs \"tests/services.*.test.ts\" \"tests/security.*.test.ts\" \"tests/util.*.test.ts\" \"tests/storage.*.test.ts\" \"tests/adapters.*.test.ts\"",
    "test:contract": "node --test --import ./tests/support/runtime-hooks.mjs \"tests/tools.*.test.ts\"",
    "typecheck": "node node_modules/typescript/lib/tsc.js --noEmit -p tsconfig.json",
    "bootstrap:tooling": "node scripts/bootstrap-tooling.mjs",
    "lint": "node scripts/lint.mjs",
    "check:coverage": "node scripts/check-coverage.mjs",
    "check:publication": "node scripts/check-publication.mjs --strict",
    "configure:repo": "node scripts/configure-repository.mjs",
    "check:pack": "node scripts/check-pack.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "author": "dsh-projectops contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-name/dsh-projectops.git"
  },
  "homepage": "https://github.com/your-name/dsh-projectops#readme",
  "bugs": {
    "url": "https://github.com/your-name/dsh-projectops/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.6.3"
  }
}
